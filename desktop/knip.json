{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/App.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/source-serif-4",
    "shadcn",
    "tailwindcss",
    "tw-animate-css"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  },
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "types"
    ]
  }
}
